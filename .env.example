# AI Workforce Sim - minimal local .env
# Copy to .env before running local MVP.

# Active game module
ACTIVE_GAME_MODULE=business_sim

# Provider routing (vendor-agnostic)
# Local default uses mock provider (no API key required).
DEFAULT_PROVIDER=mock
PROVIDER_FOR_TASK=mock
PROVIDER_FOR_EVALUATION=mock
FALLBACK_PROVIDER=mock

# Model routing
MODEL_FOR_TASK=mvp-default
MODEL_FOR_EVALUATION=mvp-default
MODEL_TASK_JUNIOR=mvp-default
MODEL_TASK_MID=mvp-default
MODEL_TASK_SENIOR=mvp-default
MODEL_EVALUATOR=mvp-default
FALLBACK_MODEL=mvp-default

# OpenAI-compatible provider examples (only needed in real provider mode)
PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
PROVIDER_OPENAI_API_KEY=

PROVIDER_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
PROVIDER_SILICONFLOW_API_KEY=

# Storage
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workforce
REDIS_URL=redis://localhost:6379/0
AGENT_CACHE_TTL_SECONDS=3600
EVALUATION_CACHE_TTL_SECONDS=3600
TASK_RESULT_CACHE_TTL_SECONDS=600
TEMP_RESULT_TTL_SECONDS=60

# CORS (comma-separated list)
CORS_ALLOW_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3000,http://localhost:3000

# Debug / benchmark safety
# Keep false for production-like consistency.
ALLOW_DEBUG_TASK_DEFINITION_OVERRIDE=false
